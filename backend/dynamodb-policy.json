{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:*:table/WizzCentral_*",
        "arn:aws:dynamodb:us-east-1:*:table/WizzUser_*",
        "arn:aws:dynamodb:us-east-1:*:table/WhizzMerchants_*",
        "arn:aws:dynamodb:us-east-1:*:table/WizzCentral_*/index/*",
        "arn:aws:dynamodb:us-east-1:*:table/WizzUser_*/index/*",
        "arn:aws:dynamodb:us-east-1:*:table/WhizzMerchants_*/index/*"
      ]
    }
  ]
}
