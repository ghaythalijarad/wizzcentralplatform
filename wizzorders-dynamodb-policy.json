{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WizzOrdersTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:031857856164:table/WizzOrders",
        "arn:aws:dynamodb:us-east-1:031857856164:table/WizzOrders/index/*"
      ]
    },
    {
      "Sid": "WizzOrdersTableReadOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListTables"
      ],
      "Resource": "*"
    }
  ]
}
